#!/usr/bin/env bash
# Project-gate: check only clean HEAD pushes; never check another ref by accident.
set -euo pipefail
cd -- "$(git rev-parse --show-toplevel)"
TARGET=$(git rev-parse HEAD)
CHECK=0
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_ref" != '(delete)' ] || continue
    if [ "$local_oid" != "$TARGET" ]; then
        echo "ERROR: project-gate only checks HEAD pushes; use an isolated target checkout for other refs." >&2
        exit 2
    fi
    CHECK=1
done
[ "$CHECK" -eq 1 ] || exit 0
verify_snapshot() {
    if [ "$(git rev-parse HEAD)" != "$TARGET" ] || ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard)" ]; then
        echo "ERROR: project-gate requires unchanged clean HEAD for push checks." >&2
        exit 2
    fi
}
[ -x ./check.sh ] || { echo "ERROR: executable check.sh is required" >&2; exit 2; }
verify_snapshot
./check.sh
verify_snapshot
